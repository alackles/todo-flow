#!/usr/bin/env bash
# Runs inbox.py in this repo's uv environment, from any working directory.
# Used by the SessionStart hook in ~/Documents/todo, so it must not fail loudly.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UV="$(command -v uv || echo "$HOME/.local/bin/uv")"
if [ ! -x "$UV" ]; then
    echo "Discord inbox: couldn't run (uv not found). Messages are still safe in Discord."
    exit 0
fi
exec "$UV" run --quiet --project "$DIR/.." python "$DIR/inbox.py" "$@"
